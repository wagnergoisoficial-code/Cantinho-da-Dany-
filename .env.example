# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ALLOWED_USER_EMAILS: Comma-separated Google account emails permitted to access APIs.
ALLOWED_USER_EMAILS="wagnergoisoficial@gmail.com,danycleanenpro@gmail.com"

# GOOGLE_MAPS_API_KEY: Private server-side Google Maps key (Geocoding & Routes APIs only).
GOOGLE_MAPS_API_KEY=

# VITE_GOOGLE_MAPS_API_KEY: Public browser key restricted by HTTP referrer (Maps JS API only).
VITE_GOOGLE_MAPS_API_KEY=
