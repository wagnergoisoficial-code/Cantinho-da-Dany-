        "schemaVersion",
        "recordVersion",
        "lastBackupAt",
        "migrationCompletedAt",
        "migratedByEmail",
        "migratedLeadCount",
        "migratedHelperCount",
        "updatedAt",
        "serverUpdatedAt",
        "updatedByEmail"
      ]
    }
  },
  "firestore": {
    "/workspaces/{workspaceId}": {
      "schema": {
        "$ref": "#/entities/Workspace"
      },
      "description": "Root workspace gate for Dany Clean Pro authorized users."
    },
    "/workspaces/{workspaceId}/settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/PricingSettingsDoc"
      },
      "description": "Commercial pricing table and business settings (doc id: pricing)."
    },
    "/workspaces/{workspaceId}/leads/{leadId}": {
      "schema": {
        "$ref": "#/entities/LeadQuoteDoc"
      },
      "description": "Individual leads, quotes, negotiation stages, and Copilot interaction histories."
    },
    "/workspaces/{workspaceId}/helpers/{helperId}": {
      "schema": {
        "$ref": "#/entities/PotentialHelperDoc"
      },
      "description": "Potential helper contacts saved from leads."
    },
    "/workspaces/{workspaceId}/meta/{metaId}": {
      "schema": {
        "$ref": "#/entities/SyncMetaDoc"
      },
      "description": "Backup timestamps and confirmed localStorage-to-Firestore migration status (doc id: sync)."
    }
  }
}
