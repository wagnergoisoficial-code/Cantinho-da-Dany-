            "recorrente",
            "primeira_avulsa",
            "deep_clean",
            "move_in_out",
            "visita_avulsa"
          ]
        },
        "frequency": {
          "type": "string"
        },
        "visitaAvulsaOption": {
          "type": "string"
        },
        "houseCondition": {
          "type": "string"
        },
        "petsOption": {
          "type": "string"
        },
        "tablePricePrimary": {
          "type": "number"
        },
        "promoPercent": {
          "type": "number"
        },
        "promoName": {
          "type": "string",
          "maxLength": 120
        },
        "finalPricePrimary": {
          "type": "number"
        },
        "tablePriceRecurring": {
          "type": "number"
        },
        "finalPriceRecurring": {
          "type": "number"
        },
        "aiConfidence": {
          "type": "number"
        },
        "aiEstado": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["Enviado", "Fechou", "Perdeu"]
        },
        "lossReason": {
          "type": "string",
          "maxLength": 500
        },
        "stage": {
          "type": "string",
          "maxLength": 64
        },
        "objection": {
          "type": "string"
        },
        "concession": {
          "type": "object"
        },
        "followUpStep": {
          "type": "string"
        },
        "nextFollowUpDate": {
          "type": "string"
        },
        "firstOutboundAt": {
          "type": "string"
        },
        "firstInboundAt": {
          "type": "string"
        },
        "lastOutboundAt": {
          "type": "string"
        },
        "lastInboundAt": {
          "type": "string"
        },
        "consecutiveOutboundCount": {
          "type": "number"
        },
        "blockedUntilDate": {
          "type": "string"
        },
        "hibernateUntilDate": {
          "type": "string"
        },
        "priceAlreadySent": {
          "type": "boolean"
        },
        "lastGeneratedMessage": {
          "type": "object"
        },
        "interactionHistory": {
          "type": "array"
        },
        "mapsInsight": {
          "type": "object"
        },
        "dayOption1": {
          "type": "string",
          "maxLength": 40
        },
        "dayOption2": {
          "type": "string",
          "maxLength": 40
        }
      },
      "required": [
        "workspaceId",
        "schemaVersion",
        "recordVersion",
        "updatedAt",
        "serverUpdatedAt",
        "updatedByEmail",
        "id",
        "createdAt",
        "clientName",
        "phone",
        "email",
        "streetAddress",
        "zipCode",
        "city",
        "desiredDate",
        "bestContact",
        "origin",
        "adCode",
        "notes",
        "squareFeet",
        "houseLabel",
        "effectiveHouseLabel",
        "serviceType",
        "frequency",
        "visitaAvulsaOption",
        "houseCondition",
        "petsOption",
        "tablePricePrimary",
        "promoPercent",
        "promoName",
        "finalPricePrimary",
        "tablePriceRecurring",
        "finalPriceRecurring",
        "aiConfidence",
        "aiEstado",
        "status",
        "lossReason",
        "stage",
        "objection",
