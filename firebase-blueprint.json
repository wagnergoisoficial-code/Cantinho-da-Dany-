{
  "entities": {
    "Workspace": {
      "title": "Workspace",
      "description": "Shared Dany Clean Pro business workspace root document.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "ownerEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "schemaVersion": {
          "type": "integer"
        },
        "recordVersion": {
          "type": "integer"
        },
        "updatedByEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "serverUpdatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workspaceId",
        "name",
        "ownerEmail",
        "schemaVersion",
        "recordVersion",
        "updatedByEmail",
        "serverUpdatedAt"
      ]
    },
    "PricingSettingsDoc": {
      "title": "PricingSettingsDoc",
      "description": "Commercial pricing table, service rules, cities, and company facts.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "schemaVersion": {
          "type": "integer"
        },
        "recordVersion": {
          "type": "integer"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "serverUpdatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedByEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "tiers": {
          "type": "array"
        },
        "moveInOutPercent": {
          "type": "number"
        },
        "conditionModeratePercent": {
          "type": "number"
        },
        "conditionHeavyPercent": {
          "type": "number"
        },
        "petOnePrice": {
          "type": "number"
        },
        "petTwoPlusPrice": {
          "type": "number"
        },
        "deepCleanRangeMarginPercent": {
          "type": "number"
        },
        "defaultDayOption1": {
          "type": "string",
          "maxLength": 40
        },
        "defaultDayOption2": {
          "type": "string",
          "maxLength": 40
        },
        "cityFixedDays": {
          "type": "array"
        },
        "serviceBaseLocation": {
          "type": "string",
          "maxLength": 200
        },
        "serviceMaxRadiusMiles": {
          "type": "number"
        },
        "servedCities": {
          "type": "array"
        },
        "companyFacts": {
          "type": "string",
          "maxLength": 12000
        },
        "extras": {
          "type": "object"
        },
        "visitaAvulsa": {
          "type": "object"
        },
        "negotiation": {
          "type": "object"
        }
      },
      "required": [
        "workspaceId",
        "schemaVersion",
        "recordVersion",
        "updatedAt",
        "serverUpdatedAt",
        "updatedByEmail",
        "tiers",
        "moveInOutPercent",
        "conditionModeratePercent",
        "conditionHeavyPercent",
        "petOnePrice",
        "petTwoPlusPrice",
        "deepCleanRangeMarginPercent",
        "defaultDayOption1",
        "defaultDayOption2",
        "cityFixedDays",
        "serviceBaseLocation",
        "serviceMaxRadiusMiles",
        "servedCities",
        "companyFacts",
        "extras",
        "visitaAvulsa",
        "negotiation"
      ]
    },
    "LeadQuoteDoc": {
      "title": "LeadQuoteDoc",
      "description": "Persisted lead, quote calculation, negotiation state, and Copilot interaction history.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "schemaVersion": {
          "type": "integer"
        },
        "recordVersion": {
          "type": "integer"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "serverUpdatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedByEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        },
        "clientName": {
          "type": "string",
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "maxLength": 180
        },
        "streetAddress": {
          "type": "string",
          "maxLength": 250
        },
        "zipCode": {
          "type": "string",
          "maxLength": 32
        },
        "city": {
          "type": "string",
          "maxLength": 120
        },
        "desiredDate": {
          "type": "string",
          "maxLength": 120
        },
        "bestContact": {
          "type": "string",
          "maxLength": 120
        },
        "origin": {
          "type": "string",
          "maxLength": 64
