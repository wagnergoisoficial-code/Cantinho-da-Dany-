    "SyncMetaDoc": {
      "title": "SyncMetaDoc",
      "description": "Synchronization metadata, backup timestamp, and migration verification state.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "schemaVersion": {
          "type": "integer"
        },
        "recordVersion": {
          "type": "integer"
        },
        "lastBackupAt": {
          "type": "string",
          "maxLength": 64
        },
        "migrationCompletedAt": {
          "type": "string",
          "maxLength": 64
        },
        "migratedByEmail": {
          "type": "string",
          "maxLength": 160
        },
        "migratedLeadCount": {
          "type": "integer"
        },
        "migratedHelperCount": {
          "type": "integer"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "serverUpdatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedByEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        }
