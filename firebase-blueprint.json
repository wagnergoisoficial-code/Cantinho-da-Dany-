        "adCode": {
          "type": "string",
          "maxLength": 120
        },
        "notes": {
          "type": "string",
          "maxLength": 6000
        },
        "squareFeet": {
          "type": "number"
        },
        "houseLabel": {
          "type": "string",
          "maxLength": 120
        },
        "effectiveHouseLabel": {
          "type": "string",
          "maxLength": 120
        },
        "serviceType": {
          "type": "string",
