    "PotentialHelperDoc": {
      "title": "PotentialHelperDoc",
      "description": "Potential helper candidate extracted from a lead.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "schemaVersion": {
          "type": "integer"
        },
        "recordVersion": {
          "type": "integer"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "serverUpdatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedByEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "maxLength": 180
        },
        "city": {
          "type": "string",
          "maxLength": 120
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        },
        "savedAt": {
          "type": "string",
          "maxLength": 64
        },
        "sourceLeadId": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "workspaceId",
        "schemaVersion",
        "recordVersion",
